# Lipservice configuration
# Copy to /etc/lipservice/lipservice.env and edit as needed.

LIPSERVICE_HOST=127.0.0.1
LIPSERVICE_PORT=8080
LIPSERVICE_USER=admin
LIPSERVICE_PASS=changeme
LIPSERVICE_TOKEN_LIFETIME=86400
LIPSERVICE_MAX_BACKLOG=1000

# Storage backend: "memory" (default) or "postgres"
# LIPSERVICE_STORAGE=memory

# Required when LIPSERVICE_STORAGE=postgres.
# Run `python -m lipservice.pg_admin setup` to generate the URI.
# LIPSERVICE_DATABASE_URI=
